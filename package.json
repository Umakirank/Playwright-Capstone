{
  "name": "automationexercise-playwright-capstone",
  "version": "1.0.0",
  "description": "Enterprise e-commerce Playwright + TypeScript automation framework (Perficient capstone)",
  "private": true,
  "scripts": {
    "install:browsers": "playwright install --with-deps",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:a11y": "playwright test --grep @a11y --project=chromium",
    "test:visual": "playwright test tests/visual.spec.ts --project=chromium",
    "test:visual:update": "playwright test tests/visual.spec.ts --project=chromium --update-snapshots",
    "test:headed": "playwright test --headed --project=chromium",
    "test:debug": "playwright test --debug --project=chromium",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report reports/html-report",
    "trace": "playwright show-trace",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
